<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratedBrandIconPath>$(IntermediateOutputPath)BeRdpClientBrand.ico</GeneratedBrandIconPath>
    <ApplicationIcon>$(GeneratedBrandIconPath)</ApplicationIcon>
  </PropertyGroup>

  <UsingTask
    TaskName="GenerateBeRdpBrandIconTask"
    TaskFactory="RoslynCodeTaskFactory"
    AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <OutputPath ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="Microsoft.Build.Framework" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var outputDirectory = Path.GetDirectoryName(OutputPath);
        if (!string.IsNullOrWhiteSpace(outputDirectory))
        {
            Directory.CreateDirectory(outputDirectory);
        }

        const int canvasSize = 64;
        var pixels = new byte[canvasSize * canvasSize * 4];

        double center = (canvasSize - 1) / 2.0;
        double radius = canvasSize * 0.46;
        for (int y = 0; y < canvasSize; y++)
        {
            for (int x = 0; x < canvasSize; x++)
            {
                var dx = x - center;
                var dy = y - center;
                if ((dx * dx) + (dy * dy) > radius * radius)
                {
                    continue;
                }

                SetPixel(x, y, 226, 6, 19, 255);
            }
        }

        for (int y = 0; y < canvasSize; y++)
        {
            for (int x = 0; x < canvasSize; x++)
            {
                if (!IsLetterPixel(x, y, canvasSize))
                {
                    continue;
                }

                var pixelIndex = (y * canvasSize + x) * 4;
                if (pixels[pixelIndex + 3] > 0)
                {
                    SetPixel(x, y, 255, 255, 255, 255);
                }
            }
        }

        File.WriteAllBytes(OutputPath, BuildIcon(canvasSize, pixels));
        Log.LogMessage(MessageImportance.Low, $"Generated BeRDP client icon: {OutputPath}");

        void SetPixel(int x, int y, byte r, byte g, byte b, byte a)
        {
            if (x < 0 || y < 0 || x >= canvasSize || y >= canvasSize)
            {
                return;
            }

            var index = (y * canvasSize + x) * 4;
            pixels[index] = r;
            pixels[index + 1] = g;
            pixels[index + 2] = b;
            pixels[index + 3] = a;
        }

        bool IsLetterPixel(int x, int y, int size)
        {
            var left = (int)Math.Round(size * 0.31);
            var top = (int)Math.Round(size * 0.2);
            var bottom = (int)Math.Round(size * 0.8);
            var stroke = Math.Max(4, size / 10);
            var middle = size / 2;
            var right = (int)Math.Round(size * 0.62);
            var middleRight = right - (stroke / 2);

            var vertical = x >= left && x < left + stroke && y >= top && y <= bottom;
            var topBar = y >= top && y < top + stroke && x >= left && x <= right;
            var middleBar = y >= middle - (stroke / 2) && y < middle + ((stroke + 1) / 2) && x >= left && x <= middleRight;
            var bottomBar = y > bottom - stroke && y <= bottom && x >= left && x <= right;
            var upperCurve = x >= right - stroke && x <= right && y >= top + stroke && y <= middle - stroke;
            var lowerCurve = x >= right - stroke && x <= right && y >= middle + stroke && y <= bottom - stroke;

            return vertical || topBar || middleBar || bottomBar || upperCurve || lowerCurve;
        }

        byte[] BuildIcon(int size, byte[] rgbaPixels)
        {
            var andMaskRowSize = ((size + 31) / 32) * 4;
            var xorBitmapSize = size * size * 4;
            var andMaskSize = andMaskRowSize * size;
            var imageDataSize = 40 + xorBitmapSize + andMaskSize;

            using var memoryStream = new MemoryStream();
            using var writer = new BinaryWriter(memoryStream);

            writer.Write((ushort)0);
            writer.Write((ushort)1);
            writer.Write((ushort)1);

            writer.Write((byte)(size == 256 ? 0 : size));
            writer.Write((byte)(size == 256 ? 0 : size));
            writer.Write((byte)0);
            writer.Write((byte)0);
            writer.Write((ushort)1);
            writer.Write((ushort)32);
            writer.Write((uint)imageDataSize);
            writer.Write((uint)22);

            writer.Write((uint)40);
            writer.Write(size);
            writer.Write(size * 2);
            writer.Write((ushort)1);
            writer.Write((ushort)32);
            writer.Write((uint)0);
            writer.Write((uint)(xorBitmapSize + andMaskSize));
            writer.Write(0);
            writer.Write(0);
            writer.Write(0);
            writer.Write(0);

            for (int y = size - 1; y >= 0; y--)
            {
                for (int x = 0; x < size; x++)
                {
                    var index = (y * size + x) * 4;
                    var r = rgbaPixels[index];
                    var g = rgbaPixels[index + 1];
                    var b = rgbaPixels[index + 2];
                    var a = rgbaPixels[index + 3];

                    writer.Write(b);
                    writer.Write(g);
                    writer.Write(r);
                    writer.Write(a);
                }
            }

            for (int i = 0; i < andMaskSize; i++)
            {
                writer.Write((byte)0);
            }

            return memoryStream.ToArray();
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="GenerateBeRdpBrandIcon" BeforeTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true'">
    <GenerateBeRdpBrandIconTask OutputPath="$(GeneratedBrandIconPath)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
