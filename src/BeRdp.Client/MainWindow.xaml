<Window x:Class="BeRdp.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BeRDP Client | Atanmış Sanal Masaüstleri"
        Width="1180"
        Height="780"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Theme.Background}"
        Foreground="{DynamicResource Brush.Theme.TextPrimary}">
  <Window.Resources>
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Brush.Theme.Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Theme.AccentForeground}" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Brush.Theme.ButtonSecondaryBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Theme.ButtonSecondaryForeground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Theme.ButtonSecondaryBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Top Corporate Header -->
    <Border Grid.Row="0"
            Background="{DynamicResource Brush.Theme.TopBarBackground}"
            BorderBrush="{DynamicResource Brush.Theme.TopBarBorder}"
            BorderThickness="0,0,0,1"
            Padding="24,14">
      <DockPanel>
        <!-- Right side actions -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="ThemeToggleButton"
                  Style="{StaticResource SecondaryButtonStyle}"
                  Margin="0,0,8,0"
                  Click="ThemeToggleButton_OnClick"
                  Content="🌙 Tema" />
          <Button Style="{StaticResource SecondaryButtonStyle}"
                  Margin="0,0,8,0"
                  Click="RefreshButton_OnClick"
                  Content="↻ Yenile" />
          <Button Style="{StaticResource SecondaryButtonStyle}"
                  Click="LogoutButton_OnClick"
                  Content="⎋ Çıkış" />
        </StackPanel>

        <!-- Brand Logo & Header -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="5" Height="28" Background="{DynamicResource Brush.Theme.Accent}" CornerRadius="2.5" Margin="0,0,12,0" />
          <StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Brush.Theme.TextPrimary}" Text="BeRDP" />
              <Border Margin="8,0,0,0" Padding="6,2" Background="{DynamicResource Brush.Theme.BadgeOnlineBackground}" CornerRadius="4">
                <TextBlock FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Theme.BadgeOnlineForeground}" Text="ÇEVRİMİÇİ" />
              </Border>
            </StackPanel>
            <TextBlock x:Name="HeaderText"
                       Margin="0,2,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource Brush.Theme.TextSecondary}" />
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Filter & Notice Bar -->
    <Border Grid.Row="1"
            Background="{DynamicResource Brush.Theme.SurfaceAlt}"
            BorderBrush="{DynamicResource Brush.Theme.Border}"
            BorderThickness="0,0,0,1"
            Padding="24,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Search input -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource Brush.Theme.TextSecondary}" Text="🔍 Filtrele:" />
          <TextBox x:Name="SearchBox"
                   Width="260"
                   Padding="8,5"
                   FontSize="12.5"
                   Background="{DynamicResource Brush.Theme.InputBackground}"
                   Foreground="{DynamicResource Brush.Theme.InputForeground}"
                   BorderBrush="{DynamicResource Brush.Theme.InputBorder}"
                   BorderThickness="1"
                   KeyDown="SearchBox_OnKeyDown"
                   TextChanged="SearchBox_OnTextChanged" />
        </StackPanel>

        <TextBlock x:Name="MachineCountText"
                   Grid.Column="1"
                   VerticalAlignment="Center"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Theme.TextSecondary}" />
      </Grid>
    </Border>

    <!-- Main Content Area -->
    <Grid Grid.Row="2" Margin="24,16,24,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Error notification banner -->
      <Border x:Name="ErrorBanner"
              Grid.Row="0"
              Margin="0,0,0,12"
              Background="#15E20613"
              BorderBrush="{DynamicResource Brush.Theme.Accent}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="14,10"
              Visibility="Collapsed">
        <TextBlock x:Name="ErrorTextBlock"
                   FontSize="13"
                   Foreground="{DynamicResource Brush.Theme.Error}"
                   TextWrapping="Wrap" />
      </Border>

      <!-- Machine Cards Grid -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="MachinesItemsControl" ItemsSource="{Binding FilteredMachines}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="270"
                      Margin="8,8,12,12"
                      Padding="16"
                      Background="{DynamicResource Brush.Theme.CardBackground}"
                      BorderBrush="{DynamicResource Brush.Theme.CardBorder}"
                      BorderThickness="1"
                      CornerRadius="12">
                <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="RDP ile Bağlan"
                              Tag="{Binding}"
                              Click="ConnectButton_OnClick" />
                    <MenuItem Header="Ekran ve RDP Ayarları"
                              Tag="{Binding}"
                              Click="MachineSettingsButton_OnClick" />
                  </ContextMenu>
                </Border.ContextMenu>

                <StackPanel>
                  <!-- Machine Name with Desktop indicator -->
                  <DockPanel Margin="0,0,0,8">
                    <Border Width="8" Height="8" CornerRadius="4"
                            Background="{DynamicResource Brush.Theme.Accent}"
                            Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock FontSize="15"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Theme.TextPrimary}"
                               Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis" />
                  </DockPanel>

                  <!-- Host / IP Endpoint -->
                  <TextBlock FontSize="12.5"
                             Foreground="{DynamicResource Brush.Theme.TextSecondary}"
                             Text="{Binding EndpointText}"
                             TextTrimming="CharacterEllipsis" />

                  <!-- Status Pill Badge -->
                  <Border Margin="0,10,0,14"
                          Padding="8,3"
                          HorizontalAlignment="Left"
                          Background="{Binding StatusBackground}"
                          CornerRadius="10">
                    <TextBlock FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{Binding StatusForeground}"
                               Text="{Binding StatusText}" />
                  </Border>

                  <!-- Action Buttons -->
                  <Button Style="{StaticResource PrimaryButtonStyle}"
                          Margin="0,0,0,6"
                          Tag="{Binding}"
                          Click="ConnectButton_OnClick"
                          Content="RDP ile Bağlan" />

                  <Button Style="{StaticResource SecondaryButtonStyle}"
                          Tag="{Binding}"
                          Click="MachineSettingsButton_OnClick"
                          Content="⚙ Ekran ve Ayarlar" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- Empty State -->
      <StackPanel x:Name="EmptyStatePanel"
                  Grid.Row="1"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Visibility="Collapsed">
        <Border Width="56" Height="56" Background="{DynamicResource Brush.Theme.SurfaceAlt}" CornerRadius="28" HorizontalAlignment="Center" Margin="0,0,0,12">
          <TextBlock Text="🖥" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock HorizontalAlignment="Center"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Theme.TextPrimary}"
                   Text="Atanmış makine bulunamadı" />
        <TextBlock Margin="0,6,0,0"
                   HorizontalAlignment="Center"
                   FontSize="13"
                   Foreground="{DynamicResource Brush.Theme.TextSecondary}"
                   Text="Hesabınıza henüz bir sanal masaüstü atanmamış veya arama kriterine uymuyor." />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
