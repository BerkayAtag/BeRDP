<Window x:Class="BeRdp.Client.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BeRDP | Kurumsal Giriş"
        Width="460"
        Height="580"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Theme.Background}"
        Foreground="{DynamicResource Brush.Theme.TextPrimary}">
  <Window.Resources>
    <Style TargetType="{x:Type TextBox}">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Theme.InputForeground}" />
      <Setter Property="Background" Value="{DynamicResource Brush.Theme.InputBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Theme.InputBorder}" />
      <Setter Property="BorderThickness" Value="1.2" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="FontSize" Value="13.5" />
    </Style>
    <Style TargetType="{x:Type PasswordBox}">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Theme.InputForeground}" />
      <Setter Property="Background" Value="{DynamicResource Brush.Theme.InputBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Theme.InputBorder}" />
      <Setter Property="BorderThickness" Value="1.2" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="FontSize" Value="13.5" />
    </Style>
  </Window.Resources>

  <Grid Margin="28,20,28,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Top Bar with Brand & Theme Toggle -->
    <DockPanel Grid.Row="0" Margin="0,0,0,16">
      <Button x:Name="ThemeToggleButton"
              DockPanel.Dock="Right"
              VerticalAlignment="Top"
              Padding="10,4"
              Background="{DynamicResource Brush.Theme.ButtonSecondaryBackground}"
              Foreground="{DynamicResource Brush.Theme.ButtonSecondaryForeground}"
              BorderBrush="{DynamicResource Brush.Theme.ButtonSecondaryBorder}"
              BorderThickness="1"
              Cursor="Hand"
              Click="ThemeToggleButton_OnClick"
              Content="🌙 Tema" />

      <StackPanel Orientation="Vertical">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="5" Height="26" Background="{DynamicResource Brush.Theme.Accent}" CornerRadius="2.5" Margin="0,0,10,0" />
          <TextBlock FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Brush.Theme.TextPrimary}" Text="BeRDP" />
        </StackPanel>
        <TextBlock Margin="15,4,0,0"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Theme.Accent}"
                   Text="DİJİTAL ÇALIŞMA ALANI" />
      </StackPanel>
    </DockPanel>

    <!-- Content / Cards -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel VerticalAlignment="Center" Margin="0,4,0,8">

        <!-- Windows SSO Section -->
        <Border Background="{DynamicResource Brush.Theme.CardBackground}"
                BorderBrush="{DynamicResource Brush.Theme.CardBorder}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16"
                Margin="0,0,0,16">
          <StackPanel>
            <TextBlock FontWeight="Bold"
                       FontSize="14"
                       Foreground="{DynamicResource Brush.Theme.TextPrimary}"
                       Text="Windows Oturumu (SSO)" />
            <TextBlock Margin="0,4,0,12"
                       FontSize="12"
                       Foreground="{DynamicResource Brush.Theme.TextSecondary}"
                       TextWrapping="Wrap"
                       Text="Windows Hello (PIN / parmak izi) ile oturum açtığınız bilgisayarda tek tıkla kurumsal kimliğiniz ile giriş yapın." />

            <Button x:Name="WindowsSsoButton"
                    Height="40"
                    Background="{DynamicResource Brush.Theme.Accent}"
                    Foreground="{DynamicResource Brush.Theme.AccentForeground}"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    FontSize="13.5"
                    Cursor="Hand"
                    Click="WindowsSsoButton_OnClick"
                    Content="⊞ Windows Oturumuyla Giriş (SSO)" />
          </StackPanel>
        </Border>

        <!-- Divider -->
        <Grid Margin="0,4,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Height="1" Background="{DynamicResource Brush.Theme.Border}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1"
                     Margin="12,0"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.Theme.TextMuted}"
                     Text="VEYA PAROLA İLE GİRİŞ" />
          <Border Grid.Column="2" Height="1" Background="{DynamicResource Brush.Theme.Border}" VerticalAlignment="Center" />
        </Grid>

        <!-- Standard Password Form -->
        <StackPanel x:Name="PasswordLoginPanel">
          <TextBlock FontWeight="SemiBold"
                     FontSize="12.5"
                     Foreground="{DynamicResource Brush.Theme.TextSecondary}"
                     TextWrapping="Wrap"
                     Text="Kullanıcı Adı / UPN (ör. user01, EXAMPLE\user01 veya user01@example.test)" />
          <TextBox x:Name="UsernameTextBox"
                   Margin="0,4,0,12" />

          <TextBlock FontWeight="SemiBold"
                     FontSize="12.5"
                     Foreground="{DynamicResource Brush.Theme.TextSecondary}"
                     Text="Parola" />
          <PasswordBox x:Name="PasswordBox"
                       Margin="0,4,0,14" />

          <Button x:Name="LoginButton"
                  IsDefault="True"
                  Height="38"
                  Background="{DynamicResource Brush.Theme.ButtonSecondaryBackground}"
                  Foreground="{DynamicResource Brush.Theme.ButtonSecondaryForeground}"
                  BorderBrush="{DynamicResource Brush.Theme.ButtonSecondaryBorder}"
                  BorderThickness="1"
                  FontWeight="SemiBold"
                  FontSize="13"
                  Cursor="Hand"
                  Click="LoginButton_OnClick"
                  Content="Parola ile Giriş Yap" />
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <!-- Footer / Info and error messages -->
    <StackPanel Grid.Row="2" Margin="0,8,0,0">
      <Border x:Name="InfoContainer"
              Background="#14005A9C"
              BorderBrush="{DynamicResource Brush.Theme.Border}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="10,8"
              Margin="0,0,0,6"
              Visibility="Collapsed">
        <TextBlock x:Name="InfoTextBlock"
                   FontSize="12"
                   Foreground="{DynamicResource Brush.Theme.TextSecondary}"
                   TextWrapping="Wrap" />
      </Border>
      <Border x:Name="ErrorContainer"
              Background="#15E20613"
              BorderBrush="{DynamicResource Brush.Theme.Accent}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="10,8"
              Visibility="Collapsed">
        <TextBlock x:Name="ErrorTextBlock"
                   FontSize="12"
                   Foreground="{DynamicResource Brush.Theme.Error}"
                   TextWrapping="Wrap" />
      </Border>
    </StackPanel>
  </Grid>
</Window>
