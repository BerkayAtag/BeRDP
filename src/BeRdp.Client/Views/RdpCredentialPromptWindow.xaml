<Window x:Class="BeRdp.Client.Views.RdpCredentialPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uzak Masaüstü Kimlik Doğrulaması"
        Width="480"
        Height="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Theme.Background}"
        Foreground="{DynamicResource Brush.Theme.TextPrimary}">
  <Border Padding="24">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Header with BeRDP Red accent -->
      <StackPanel Grid.Row="0" Margin="0,0,0,16">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="4" Height="22" Background="{DynamicResource Brush.Theme.Accent}" CornerRadius="2" Margin="0,0,10,0" />
          <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.Theme.TextPrimary}" Text="Uzak Masaüstü Bağlantısı" />
        </StackPanel>
        <TextBlock Margin="14,6,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource Brush.Theme.TextSecondary}"
                   TextWrapping="Wrap"
                   Text="Hedef makinede Windows Hello bulunmadığından Active Directory (domain) parolanız ile bağlantı kurulur." />
      </StackPanel>

      <!-- Body / Inputs -->
      <StackPanel Grid.Row="1" VerticalAlignment="Center">
        <Border Background="{DynamicResource Brush.Theme.CardBackground}"
                BorderBrush="{DynamicResource Brush.Theme.CardBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,12">
          <StackPanel>
            <TextBlock FontWeight="SemiBold"
                       FontSize="13"
                       Foreground="{DynamicResource Brush.Theme.TextSecondary}"
                       Text="Domain Kullanıcı Adı (Varsayılan)" />
            <TextBlock x:Name="UsernameDisplay"
                       Margin="0,4,0,12"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Brush.Theme.TextPrimary}" />

            <TextBlock FontWeight="SemiBold"
                       FontSize="13"
                       Foreground="{DynamicResource Brush.Theme.TextSecondary}"
                       Text="Active Directory (AD) Parolası" />
            <PasswordBox x:Name="PasswordInput"
                         Margin="0,6,0,8"
                         Padding="10,8"
                         FontSize="14"
                         Background="{DynamicResource Brush.Theme.InputBackground}"
                         Foreground="{DynamicResource Brush.Theme.InputForeground}"
                         BorderBrush="{DynamicResource Brush.Theme.InputBorder}"
                         BorderThickness="1" />

            <CheckBox x:Name="RememberSessionCheckBox"
                      Margin="0,4,0,0"
                      IsChecked="True"
                      Foreground="{DynamicResource Brush.Theme.TextPrimary}"
                      Content="Bu oturum boyunca parolamı hatırla" />
          </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorText"
                   FontSize="12"
                   Foreground="{DynamicResource Brush.Theme.Error}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />
      </StackPanel>

      <!-- Actions -->
      <StackPanel Grid.Row="2" Margin="0,12,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Button x:Name="ConnectDirectButton"
                  IsDefault="True"
                  Grid.Column="0"
                  Height="38"
                  Background="{DynamicResource Brush.Theme.Accent}"
                  Foreground="{DynamicResource Brush.Theme.AccentForeground}"
                  FontWeight="SemiBold"
                  BorderThickness="0"
                  Cursor="Hand"
                  Click="ConnectDirectButton_OnClick"
                  Content="Doğrudan Bağlan" />

          <Button x:Name="PromptInMstscButton"
                  Grid.Column="2"
                  Height="38"
                  Background="{DynamicResource Brush.Theme.ButtonSecondaryBackground}"
                  Foreground="{DynamicResource Brush.Theme.ButtonSecondaryForeground}"
                  BorderBrush="{DynamicResource Brush.Theme.ButtonSecondaryBorder}"
                  BorderThickness="1"
                  FontWeight="SemiBold"
                  Cursor="Hand"
                  Click="PromptInMstscButton_OnClick"
                  Content="RDP'de Sor (mstsc)" />
        </Grid>

        <Button Margin="0,8,0,0"
                Height="32"
                Background="Transparent"
                Foreground="{DynamicResource Brush.Theme.TextSecondary}"
                BorderThickness="0"
                Cursor="Hand"
                Click="CancelButton_OnClick"
                Content="İptal" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
