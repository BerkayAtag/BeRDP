<Window x:Class="BeRdp.Client.Views.RdpLocalResourcesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RDP Bağlantı Ayarları"
        Width="700"
        Height="760"
        MinWidth="620"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Theme.Background}"
        Foreground="{DynamicResource Brush.Theme.TextPrimary}">
  <Window.Resources>
    <Style TargetType="{x:Type TextBlock}">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Theme.TextPrimary}" />
    </Style>
    <Style TargetType="{x:Type CheckBox}">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Theme.TextPrimary}" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style TargetType="{x:Type TextBox}">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Theme.InputForeground}" />
      <Setter Property="Background" Value="{DynamicResource Brush.Theme.InputBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Theme.InputBorder}" />
      <Setter Property="BorderThickness" Value="1.2" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="FontSize" Value="13" />
    </Style>
  </Window.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header with BeRDP Red accent -->
    <StackPanel Grid.Row="0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="5" Height="24" Background="{DynamicResource Brush.Theme.Accent}" CornerRadius="2.5" Margin="0,0,10,0" />
        <TextBlock x:Name="MachineTitleText"
                   FontSize="20"
                   FontWeight="Bold"
                   Text="Makine Ayarları" />
      </StackPanel>
      <TextBlock Margin="15,6,0,0"
                 Foreground="{DynamicResource Brush.Theme.TextSecondary}"
                 TextWrapping="Wrap"
                 Text="Bu makine için RDP bağlantısında kullanılacak yerel aygıt ve ekran ayarlarını belirleyin." />
      <TextBlock Margin="15,4,0,0"
                 FontSize="11.5"
                 Foreground="{DynamicResource Brush.Theme.TextMuted}"
                 TextWrapping="Wrap"
                 Text="Sabit uygulanan kurumsal ayarlar: 32-bit renk derinliği, otomatik ağ tespiti, ses çalma/kaydetme, font yumuşatma." />
    </StackPanel>

    <!-- Settings Groups -->
    <ScrollViewer Grid.Row="1"
                  Margin="0,16,0,16"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <!-- Display and Resolution -->
        <Border Padding="16"
                Background="{DynamicResource Brush.Theme.CardBackground}"
                BorderBrush="{DynamicResource Brush.Theme.CardBorder}"
                BorderThickness="1"
                CornerRadius="10">
          <StackPanel>
            <TextBlock FontSize="15"
                       FontWeight="Bold"
                       Text="Ekranlar ve Çözünürlük" />

            <CheckBox x:Name="UseAllMonitorsCheckBox"
                      Margin="0,12,0,0"
                      Content="Uzak oturum için tüm monitörlerimi kullan"
                      Checked="DisplaySelection_OnChanged"
                      Unchecked="DisplaySelection_OnChanged" />

            <TextBlock Margin="0,12,0,6"
                       FontSize="12.5"
                       Foreground="{DynamicResource Brush.Theme.TextSecondary}"
                       Text="Kullanılacak aktif monitörleri seçin:" />

            <Border Background="{DynamicResource Brush.Theme.SurfaceAlt}"
                    BorderBrush="{DynamicResource Brush.Theme.Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4"
                    Margin="0,0,0,8">
              <Canvas x:Name="MonitorLayoutCanvas" Height="140" ClipToBounds="True" Background="Transparent" />
            </Border>

            <ItemsControl x:Name="MonitorsItemsControl"
                          ItemsSource="{Binding Monitors}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,3"
                          Padding="10,8"
                          Background="{DynamicResource Brush.Theme.SurfaceAlt}"
                          BorderBrush="{DynamicResource Brush.Theme.Border}"
                          BorderThickness="1"
                          CornerRadius="6">
                    <CheckBox Content="{Binding DisplayText}"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <CheckBox x:Name="CustomResolutionCheckBox"
                      Margin="0,14,0,0"
                      Content="Özel çözünürlük kullan (yalnızca tek monitör pencere modu)"
                      Checked="DisplaySelection_OnChanged"
                      Unchecked="DisplaySelection_OnChanged" />

            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="DesktopWidthTextBox"
                       Grid.Column="0"
                       MinHeight="34"
                       VerticalContentAlignment="Center"
                       ToolTip="Genişlik (piksel)" />
              <TextBlock Grid.Column="1"
                         Margin="12,0"
                         VerticalAlignment="Center"
                         FontWeight="Bold"
                         Foreground="{DynamicResource Brush.Theme.TextSecondary}"
                         Text="✕" />
              <TextBox x:Name="DesktopHeightTextBox"
                       Grid.Column="2"
                       MinHeight="34"
                       VerticalContentAlignment="Center"
                       ToolTip="Yükseklik (piksel)" />
            </Grid>

            <TextBlock x:Name="DisplayValidationText"
                       Margin="0,8,0,0"
                       Foreground="{DynamicResource Brush.Theme.Accent}"
                       FontWeight="Medium"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- Local Resources -->
        <Border Margin="0,12,0,0"
                Padding="16"
                Background="{DynamicResource Brush.Theme.CardBackground}"
                BorderBrush="{DynamicResource Brush.Theme.CardBorder}"
                BorderThickness="1"
                CornerRadius="10">
          <StackPanel>
            <TextBlock FontSize="15"
                       FontWeight="Bold"
                       Text="Yerel Aygıtlar ve Kaynaklar" />
            <CheckBox x:Name="ClipboardCheckBox"
                      Margin="0,12,0,0"
                      Content="Pano / Kopyala-Yapıştır paylaşımı (Clipboard)" />
            <CheckBox x:Name="PrintersCheckBox"
                      Margin="0,10,0,0"
                      Content="Yazıcıları yönlendir" />
            <CheckBox x:Name="SmartCardsCheckBox"
                      Margin="0,10,0,0"
                      Content="Akıllı kartları yönlendir" />
            <CheckBox x:Name="DrivesCheckBox"
                      Margin="0,10,0,0"
                      Content="Yerel disk sürücülerini yönlendir" />
            <CheckBox x:Name="ComPortsCheckBox"
                      Margin="0,10,0,0"
                      Content="Seri (COM) portlarını yönlendir" />
            <CheckBox x:Name="PnPDevicesCheckBox"
                      Margin="0,10,0,0"
                      Content="Tak-çalıştır (PnP) cihazlarını yönlendir" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Bottom Actions -->
    <DockPanel Grid.Row="2" Margin="0,8,0,0">
      <Button x:Name="CancelButton"
              Width="120"
              Height="38"
              Margin="0,0,10,0"
              HorizontalAlignment="Right"
              Background="{DynamicResource Brush.Theme.ButtonSecondaryBackground}"
              Foreground="{DynamicResource Brush.Theme.ButtonSecondaryForeground}"
              BorderBrush="{DynamicResource Brush.Theme.ButtonSecondaryBorder}"
              BorderThickness="1"
              FontWeight="SemiBold"
              Cursor="Hand"
              Content="Vazgeç"
              Click="CancelButton_OnClick"
              DockPanel.Dock="Right" />
      <Button x:Name="SaveButton"
              IsDefault="True"
              Width="150"
              Height="38"
              HorizontalAlignment="Right"
              Background="{DynamicResource Brush.Theme.Accent}"
              Foreground="{DynamicResource Brush.Theme.AccentForeground}"
              BorderThickness="0"
              FontWeight="SemiBold"
              Cursor="Hand"
              Content="Ayarları Kaydet"
              Click="SaveButton_OnClick"
              DockPanel.Dock="Right" />
    </DockPanel>
  </Grid>
</Window>
